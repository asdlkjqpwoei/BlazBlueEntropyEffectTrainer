<Window
    x:Class="BlazblueTrainer.DataBodyWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="EditorRoot" Margin="16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="EditorTitle" FontSize="22" FontWeight="SemiBold" />
            <Button x:Name="EditorLanguageButton" Grid.Column="1" Click="OnEditorLanguageChanged" />
        </Grid>
        <TextBlock x:Name="OfflineNotice" Grid.Row="1" TextWrapping="Wrap" Opacity="0.8" />
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="GameDirectoryInput" />
            <Button x:Name="BrowseGameButton" Grid.Column="1" Click="OnBrowseGame" />
        </Grid>
        <ContentControl x:Name="OfflineControls" Grid.Row="3"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="SavePathInput" />
                    <Button x:Name="BrowseSaveButton" Grid.Column="1" Click="OnBrowseSave" />
                    <Button x:Name="LoadSaveButton" Grid.Column="2" Click="OnLoadSave" />
                </Grid>
                <ComboBox x:Name="SaveSlotSelector" Grid.Row="1" HorizontalAlignment="Stretch"
                          SelectionChanged="OnSaveSlotChanged" />
                <TextBlock x:Name="WarehouseInfo" Grid.Row="2" TextWrapping="Wrap" FontSize="12" />
                <Pivot x:Name="EditorTabs" Grid.Row="3" SelectionChanged="OnTabChanged">
                    <PivotItem x:Name="EditTab">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid RowSpacing="6">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock x:Name="BodyListHeading" FontWeight="SemiBold" />
                                <ListView x:Name="BodyList" Grid.Row="1" SelectionMode="Single"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          SelectionChanged="OnBodyChanged">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Padding" Value="8" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                </ListView>
                            </Grid>
                            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="SelectedBodyText" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="EditInheritanceHeading" FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                                        <ComboBox x:Name="EditInheritanceFirst" HorizontalAlignment="Stretch"
                                                  IsTextSearchEnabled="True" SelectionChanged="OnInheritanceChanged" />
                                        <ComboBox x:Name="EditQualityFirst" Grid.Column="1" HorizontalAlignment="Stretch"
                                                  SelectionChanged="OnInheritanceChanged" />
                                    </Grid>
                                    <TextBlock x:Name="EditConditionFirst" TextWrapping="Wrap" FontSize="12" />
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                                        <ComboBox x:Name="EditInheritanceSecond" HorizontalAlignment="Stretch"
                                                  IsTextSearchEnabled="True" SelectionChanged="OnInheritanceChanged" />
                                        <ComboBox x:Name="EditQualitySecond" Grid.Column="1" HorizontalAlignment="Stretch"
                                                  SelectionChanged="OnInheritanceChanged" />
                                    </Grid>
                                    <TextBlock x:Name="EditConditionSecond" TextWrapping="Wrap" FontSize="12" />
                                    <TextBlock x:Name="EditSkillHeading" FontWeight="SemiBold" />
                                    <ComboBox x:Name="EditSkillSelector" HorizontalAlignment="Stretch"
                                              SelectionChanged="OnSkillChanged" />
                                    <Button x:Name="ApplyEditButton" HorizontalAlignment="Stretch"
                                            IsEnabled="False" Click="OnApplyEdit" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </PivotItem>
                    <PivotItem x:Name="AddTab">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="8" MaxWidth="560" HorizontalAlignment="Left">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="NewActorSelector" HorizontalAlignment="Stretch"
                                              SelectionChanged="OnActorChanged" />
                                    <ComboBox x:Name="NewColorSelector" Grid.Column="1" HorizontalAlignment="Stretch" />
                                </Grid>
                                <TextBlock x:Name="NewInheritanceHeading" FontWeight="SemiBold" />
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="NewInheritanceFirst" HorizontalAlignment="Stretch"
                                              IsTextSearchEnabled="True" SelectionChanged="OnInheritanceChanged" />
                                    <ComboBox x:Name="NewQualityFirst" Grid.Column="1" HorizontalAlignment="Stretch"
                                              SelectionChanged="OnInheritanceChanged" />
                                </Grid>
                                <TextBlock x:Name="NewConditionFirst" TextWrapping="Wrap" FontSize="12" />
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="NewInheritanceSecond" HorizontalAlignment="Stretch"
                                              IsTextSearchEnabled="True" SelectionChanged="OnInheritanceChanged" />
                                    <ComboBox x:Name="NewQualitySecond" Grid.Column="1" HorizontalAlignment="Stretch"
                                              SelectionChanged="OnInheritanceChanged" />
                                </Grid>
                                <TextBlock x:Name="NewConditionSecond" TextWrapping="Wrap" FontSize="12" />
                                <TextBlock x:Name="NewSkillHeading" FontWeight="SemiBold" />
                                <ComboBox x:Name="NewSkillSelector" HorizontalAlignment="Stretch"
                                          SelectionChanged="OnSkillChanged" />
                                <Button x:Name="ApplyAddButton" HorizontalAlignment="Stretch"
                                        IsEnabled="False" Click="OnApplyAdd" />
                            </StackPanel>
                        </ScrollViewer>
                    </PivotItem>
                </Pivot>
            </Grid>
        </ContentControl>
        <StackPanel Grid.Row="4" Spacing="4">
            <TextBlock x:Name="EditorStatus" TextWrapping="Wrap" FontSize="12" />
            <TextBlock x:Name="SaveOperationText" TextWrapping="Wrap" MaxHeight="64" />
        </StackPanel>
    </Grid>
</Window>
