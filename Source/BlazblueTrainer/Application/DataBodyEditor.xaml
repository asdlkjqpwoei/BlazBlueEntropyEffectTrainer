<UserControl x:Class="BlazblueTrainer.DataBodyEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Grid x:Name="EditorRoot" RowSpacing="8" Padding="0,4,0,0">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<TextBlock x:Name="OfflineNotice" TextWrapping="Wrap" FontSize="12" Opacity="0.8" />
		<ContentControl x:Name="GameSourceControls" Grid.Row="1" HorizontalContentAlignment="Stretch">
			<Grid ColumnSpacing="8">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<TextBox x:Name="GameDirectoryInput" MinWidth="0" />
				<Button x:Name="BrowseGameButton" Grid.Column="1" Click="OnBrowseGame" />
			</Grid>
		</ContentControl>
		<ContentControl x:Name="SaveSourceControls" Grid.Row="2" HorizontalContentAlignment="Stretch">
			<Grid ColumnSpacing="8">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="190" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<TextBox x:Name="SavePathInput" MinWidth="0" />
				<ComboBox x:Name="SaveSlotSelector" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="OnSaveSlotChanged" />
				<Button x:Name="BrowseSaveButton" Grid.Column="2" Click="OnBrowseSave" />
				<Button x:Name="LoadSaveButton" Grid.Column="3" Click="OnLoadSave" />
			</Grid>
		</ContentControl>
		<TextBlock x:Name="WarehouseInfo" Grid.Row="3" TextWrapping="Wrap" FontSize="12" />
		<ContentControl x:Name="OfflineControls" Grid.Row="4" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
			<Grid ColumnSpacing="12">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="200" />
					<ColumnDefinition Width="280" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<Grid RowSpacing="6">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<TextBlock x:Name="BodyListHeading" FontWeight="SemiBold" />
					<ListView x:Name="BodyList" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnBodyChanged" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
						<ListView.ItemTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" />
							</DataTemplate>
						</ListView.ItemTemplate>
						<ListView.ItemContainerStyle>
							<Style TargetType="ListViewItem">
								<Setter Property="Padding" Value="6" />
								<Setter Property="HorizontalContentAlignment" Value="Stretch" />
							</Style>
						</ListView.ItemContainerStyle>
					</ListView>
				</Grid>
				<Pivot x:Name="EditorTabs" Grid.Column="1" SelectionChanged="OnTabChanged">
					<PivotItem x:Name="EditTab" Margin="0">
						<ScrollViewer HorizontalScrollBarVisibility="Disabled">
							<StackPanel Spacing="8">
								<TextBlock x:Name="SelectedBodyText" FontWeight="SemiBold" TextWrapping="Wrap" />
								<TextBlock x:Name="EditInheritanceHeading" FontWeight="SemiBold" />
								<Grid ColumnSpacing="4">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="58" />
										<ColumnDefinition Width="32" />
									</Grid.ColumnDefinitions>
									<Button x:Name="EditFirstButton" Tag="edit:0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnInspectSlot">
										<TextBlock x:Name="EditFirstLabel" TextWrapping="Wrap" FontSize="12" />
									</Button>
									<ComboBox x:Name="EditQualityFirst" Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" SelectionChanged="OnQualityChanged" />
									<Button Tag="edit:0" Grid.Column="2" Content="×" Padding="0" HorizontalAlignment="Stretch" Click="OnClearSlot" />
								</Grid>
								<TextBlock x:Name="EditConditionFirst" TextWrapping="Wrap" FontSize="12" />
								<Grid ColumnSpacing="4">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="58" />
										<ColumnDefinition Width="32" />
									</Grid.ColumnDefinitions>
									<Button x:Name="EditSecondButton" Tag="edit:1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnInspectSlot">
										<TextBlock x:Name="EditSecondLabel" TextWrapping="Wrap" FontSize="12" />
									</Button>
									<ComboBox x:Name="EditQualitySecond" Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" SelectionChanged="OnQualityChanged" />
									<Button Tag="edit:1" Grid.Column="2" Content="×" Padding="0" HorizontalAlignment="Stretch" Click="OnClearSlot" />
								</Grid>
								<TextBlock x:Name="EditConditionSecond" TextWrapping="Wrap" FontSize="12" />
								<TextBlock x:Name="EditSkillHeading" FontWeight="SemiBold" />
								<ComboBox x:Name="EditSkillSelector" HorizontalAlignment="Stretch" SelectionChanged="OnSkillChanged" />
								<TextBlock x:Name="DraftHint" TextWrapping="Wrap" FontSize="12" Opacity="0.7" />
							</StackPanel>
						</ScrollViewer>
					</PivotItem>
					<PivotItem x:Name="AddTab" Margin="0">
						<ScrollViewer HorizontalScrollBarVisibility="Disabled">
							<StackPanel Spacing="8">
								<ComboBox x:Name="NewActorSelector" HorizontalAlignment="Stretch" SelectionChanged="OnActorChanged" />
								<ComboBox x:Name="NewColorSelector" HorizontalAlignment="Stretch" />
								<TextBlock x:Name="NewInheritanceHeading" FontWeight="SemiBold" />
								<Grid ColumnSpacing="4">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="58" />
										<ColumnDefinition Width="32" />
									</Grid.ColumnDefinitions>
									<Button Tag="new:0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnInspectSlot">
										<TextBlock x:Name="NewFirstLabel" TextWrapping="Wrap" FontSize="12" />
									</Button>
									<ComboBox x:Name="NewQualityFirst" Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" SelectionChanged="OnQualityChanged" />
									<Button Tag="new:0" Grid.Column="2" Content="×" Padding="0" HorizontalAlignment="Stretch" Click="OnClearSlot" />
								</Grid>
								<TextBlock x:Name="NewConditionFirst" TextWrapping="Wrap" FontSize="12" />
								<Grid ColumnSpacing="4">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="58" />
										<ColumnDefinition Width="32" />
									</Grid.ColumnDefinitions>
									<Button Tag="new:1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnInspectSlot">
										<TextBlock x:Name="NewSecondLabel" TextWrapping="Wrap" FontSize="12" />
									</Button>
									<ComboBox x:Name="NewQualitySecond" Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" SelectionChanged="OnQualityChanged" />
									<Button Tag="new:1" Grid.Column="2" Content="×" Padding="0" HorizontalAlignment="Stretch" Click="OnClearSlot" />
								</Grid>
								<TextBlock x:Name="NewConditionSecond" TextWrapping="Wrap" FontSize="12" />
								<TextBlock x:Name="NewSkillHeading" FontWeight="SemiBold" />
								<ComboBox x:Name="NewSkillSelector" HorizontalAlignment="Stretch" SelectionChanged="OnSkillChanged" />
								<Button x:Name="ApplyAddButton" HorizontalAlignment="Stretch" IsEnabled="False" Click="OnApplyAdd" />
							</StackPanel>
						</ScrollViewer>
					</PivotItem>
				</Pivot>
				<Grid Grid.Column="2" RowSpacing="6">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<TextBlock x:Name="StrategyHeading" FontWeight="SemiBold" />
					<TextBox x:Name="StrategySearch" Grid.Row="1" TextChanged="OnStrategySearchChanged" />
					<Grid Grid.Row="2" ColumnSpacing="6" RowSpacing="6">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<ComboBox x:Name="ElementFilter" HorizontalAlignment="Stretch" SelectionChanged="OnStrategyFilterChanged" />
						<ComboBox x:Name="TriggerFilter" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="OnStrategyFilterChanged" />
						<ComboBox x:Name="DualFilter" Grid.Row="1" HorizontalAlignment="Stretch" SelectionChanged="OnStrategyFilterChanged" />
						<ComboBox x:Name="TierFilter" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="OnStrategyFilterChanged" />
					</Grid>
					<TextBlock x:Name="StrategyCount" Grid.Row="3" FontSize="12" Opacity="0.7" />
					<ListView x:Name="StrategyList" Grid.Row="4" SelectionMode="Single" SelectionChanged="OnStrategySelected" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
						<ListView.ItemTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" />
							</DataTemplate>
						</ListView.ItemTemplate>
						<ListView.ItemContainerStyle>
							<Style TargetType="ListViewItem">
								<Setter Property="Padding" Value="6" />
								<Setter Property="HorizontalContentAlignment" Value="Stretch" />
							</Style>
						</ListView.ItemContainerStyle>
					</ListView>
					<ScrollViewer Grid.Row="5" MaxHeight="112" HorizontalScrollBarVisibility="Disabled">
						<TextBlock x:Name="StrategyPreview" TextWrapping="Wrap" FontSize="12" />
					</ScrollViewer>
					<Grid Grid.Row="6" ColumnSpacing="6">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<Button x:Name="UseFirstButton" Tag="0" HorizontalAlignment="Stretch" IsEnabled="False" Click="OnUseStrategy" />
						<Button x:Name="UseSecondButton" Grid.Column="1" Tag="1" HorizontalAlignment="Stretch" IsEnabled="False" Click="OnUseStrategy" />
					</Grid>
				</Grid>
			</Grid>
		</ContentControl>
		<StackPanel Grid.Row="5" Spacing="4">
			<Grid ColumnSpacing="8">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<TextBlock x:Name="PendingText" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
				<Button x:Name="ResetAllButton" Grid.Column="1" IsEnabled="False" Click="OnResetAll" />
				<Button x:Name="SaveAllButton" Grid.Column="2" IsEnabled="False" Click="OnSaveAll" />
			</Grid>
			<TextBlock x:Name="EditorStatus" TextWrapping="Wrap" FontSize="12" />
			<TextBlock x:Name="SaveOperationText" TextWrapping="Wrap" MaxHeight="40" FontSize="12" />
		</StackPanel>
	</Grid>
</UserControl>
