root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = tab
indent_size = tab
tab_width = 4
trim_trailing_whitespace = true

# YAML block indentation requires spaces.
[*.{yaml,yml}]
indent_style = space
indent_size = 2

[.clang-tidy]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
