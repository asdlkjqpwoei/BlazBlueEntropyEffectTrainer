function(GetImportedArtifact Target Property Configuration Output)
    string(TOUPPER "${Configuration}" UpperConfiguration)
    get_target_property(Mapped "${Target}" "MAP_IMPORTED_CONFIG_${UpperConfiguration}")
    get_target_property(Available "${Target}" IMPORTED_CONFIGURATIONS)
    set(Candidates "${UpperConfiguration}")
    if(Mapped)
        list(APPEND Candidates ${Mapped})
    endif()
    list(APPEND Candidates NOCONFIG "")
    if(Available)
        list(APPEND Candidates ${Available})
    endif()
    foreach(Candidate IN LISTS Candidates)
        string(TOUPPER "${Candidate}" Candidate)
        if(Candidate)
            set(Name "${Property}_${Candidate}")
        else()
            set(Name "${Property}")
        endif()
        get_target_property(Value "${Target}" "${Name}")
        if(Value)
            set(${Output} "${Value}" PARENT_SCOPE)
            return()
        endif()
    endforeach()
    get_target_property(Value "${Target}" "${Property}")
    if(NOT Value)
        message(FATAL_ERROR "${Target} does not provide ${Property} for ${Configuration}.")
    endif()
    set(${Output} "${Value}" PARENT_SCOPE)
endfunction()

function(WriteNativeDependencies Configuration)
    get_target_property(YamlType yaml-cpp::yaml-cpp TYPE)
    get_target_property(YamlIncludes yaml-cpp::yaml-cpp INTERFACE_INCLUDE_DIRECTORIES)
    get_target_property(YamlDefinitions yaml-cpp::yaml-cpp INTERFACE_COMPILE_DEFINITIONS)
    if(NOT YamlDefinitions)
        set(YamlDefinitions "")
    endif()
    set(YamlRuntime "")
    if(YamlType STREQUAL "SHARED_LIBRARY")
        GetImportedArtifact(yaml-cpp::yaml-cpp IMPORTED_IMPLIB "${Configuration}" YamlLibrary)
        GetImportedArtifact(yaml-cpp::yaml-cpp IMPORTED_LOCATION "${Configuration}" YamlRuntime)
    else()
        GetImportedArtifact(yaml-cpp::yaml-cpp IMPORTED_LOCATION "${Configuration}" YamlLibrary)
        list(APPEND YamlDefinitions YAML_CPP_STATIC_DEFINE)
        list(REMOVE_DUPLICATES YamlDefinitions)
    endif()
    EscapeXml("${YamlLibrary}" XmlYamlLibrary)
    EscapeXml("${YamlRuntime}" XmlYamlRuntime)
    EscapeXml("${YamlIncludes}" XmlYamlIncludes)
    EscapeXml("${YamlDefinitions}" XmlYamlDefinitions)
    file(CONFIGURE OUTPUT "${NativeProjectDirectory}/Dependencies.${Configuration}.props"
        CONTENT "<?xml version=\"1.0\" encoding=\"utf-8\"?>
<Project xmlns=\"http://schemas.microsoft.com/developer/msbuild/2003\">
  <PropertyGroup>
    <TrainerYamlLibrary>${XmlYamlLibrary}</TrainerYamlLibrary>
    <TrainerYamlRuntime>${XmlYamlRuntime}</TrainerYamlRuntime>
    <TrainerYamlInclude>${XmlYamlIncludes}</TrainerYamlInclude>
    <TrainerDependencyDefinitions>${XmlYamlDefinitions}</TrainerDependencyDefinitions>
  </PropertyGroup>
</Project>
" @ONLY)
endfunction()
